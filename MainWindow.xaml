<Window x:Class="WindowsNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch" Height="40" Width="250"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Tombol ikon tanpa chrome, dengan efek hover -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar tipis ala mockup -->
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#3A3A3A"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#3D7EFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bar tipis untuk metrik sistem (CPU/RAM/disk) -->
        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#3D7EFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                    CornerRadius="1.5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="1.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Pill: ukurannya dianimasikan di dalam window yang sudah snap ukuran -->
        <Grid x:Name="PillHost" Width="250" Height="40" ClipToBounds="True"
              HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand">
            <!-- Shape pill: tepi atas flare keluar, bawah radius normal -->
            <Path x:Name="NotchShape" Fill="Black"/>

        <Grid x:Name="ContentRoot" Margin="16,0">
            <!-- State 1: Idle dashboard (saat tidak ada sesi media) -->
            <Grid x:Name="IdleRoot" Visibility="Collapsed" VerticalAlignment="Stretch">
                <!-- Collapsed: hanya jam dan tanggal agar capsule tetap bersih -->
                <StackPanel x:Name="IdleCompactRoot" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="CompactClockText" Text="08:42" Foreground="White"
                               FontSize="15" FontWeight="SemiBold" LineHeight="17"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CompactDateText" Text="Sen, 19 Okt" Foreground="#9A9A9E"
                               FontSize="9" LineHeight="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Expanded: jam besar, tanggal, metrik lengkap, baterai -->
                <Grid x:Name="IdleExpandedRoot" Visibility="Collapsed" Margin="8,8,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpandedClockText" Text="08:42" Foreground="White"
                                   FontSize="26" FontWeight="SemiBold" LineHeight="28"/>
                        <TextBlock x:Name="ExpandedDateText" Text="Senin, 19 Okt 2026"
                                   Foreground="#9A9A9E" FontSize="9" LineHeight="11"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="ExpandedBatteryPanel" Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <Border Width="20" Height="10" BorderBrush="#C8C8CC"
                                    BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <Grid Margin="1">
                                    <Border x:Name="ExpandedBatteryFill" Width="0"
                                            HorizontalAlignment="Left" Background="#4CD964"
                                            CornerRadius="1"/>
                                </Grid>
                            </Border>
                            <Border Width="2" Height="4" Background="#C8C8CC" CornerRadius="1"
                                    Margin="1,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExpandedBatteryText" Text="82%" Foreground="#C8C8CC"
                                       FontSize="8.5" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="ExpandedCpuRow" Height="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Foreground="#9A9A9E" FontSize="8"
                                       VerticalAlignment="Center"/>
                            <ProgressBar x:Name="ExpandedCpuBar" Grid.Column="1"
                                         Style="{StaticResource MetricBar}"
                                         Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExpandedCpuText" Grid.Column="2" Text="--%"
                                       Foreground="#C8C8CC" FontSize="8.5"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid x:Name="ExpandedRamRow" Grid.Row="1" Height="15" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" Foreground="#9A9A9E" FontSize="8"
                                       VerticalAlignment="Center"/>
                            <ProgressBar x:Name="ExpandedRamBar" Grid.Column="1"
                                         Style="{StaticResource MetricBar}"
                                         Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExpandedRamText" Grid.Column="2" Text="--%"
                                       Foreground="#C8C8CC" FontSize="8.5"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid x:Name="ExpandedDiskRow" Grid.Row="2" Height="15" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExpandedDiskLabel" Text="C:" Foreground="#9A9A9E"
                                       FontSize="8" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="ExpandedDiskBar" Grid.Column="1"
                                         Style="{StaticResource MetricBar}"
                                         Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExpandedDiskText" Grid.Column="2" Text="--%"
                                       Foreground="#C8C8CC" FontSize="8.5"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>

            <!-- State 3: Mode sisi (menempel layar kiri/kanan), collapsed -->
            <StackPanel x:Name="SideCollapsedRoot" Width="40" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="SideAlbumArtBorder" Width="24" Height="24"
                        CornerRadius="6" Background="#2B2B2B">
                    <Grid>
                        <TextBlock x:Name="SideAlbumArtPlaceholder" Text="&#x266A;" FontSize="12"
                                   Foreground="#8A8A8A" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="SideAlbumArt" Stretch="UniformToFill" Visibility="Collapsed">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <Button x:Name="SidePauseButton" Style="{StaticResource IconButton}"
                        Padding="8,6" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Viewbox Width="10" Height="13" Stretch="Uniform">
                        <Path x:Name="SidePausePath" Fill="White"
                              Data="M0,0 h4 v13 h-4 z M6,0 h4 v13 h-4 z"/>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- Idle mode sisi: hanya jam, hari, dan tanggal -->
            <StackPanel x:Name="SideIdleRoot" Width="40" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="SideHourText" Text="08" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           LineHeight="13"/>
                <TextBlock x:Name="SideMinuteText" Text="42" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           LineHeight="13" Margin="0,-1,0,0"/>
                <Border Width="20" Height="1" Background="#2F2F2F" Margin="0,6,0,0"/>
                <TextBlock x:Name="SideDayText" Text="Sen" Foreground="#9A9A9E"
                           FontSize="8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="SideDateText" Text="19 Okt" Foreground="#C8C8CC"
                           FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- State 2: Media player (sesuai mockup) -->
            <Grid x:Name="MediaRoot" VerticalAlignment="Top" Margin="0,6.5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Baris 1: album art + judul/artist + sisi kanan -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="AlbumArtBorder" Width="24" Height="24"
                            CornerRadius="6" Background="#2B2B2B" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="AlbumArtPlaceholder" Text="&#x266A;" FontSize="12"
                                       Foreground="#8A8A8A" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image x:Name="AlbumArt" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="TextStack" Grid.Column="1" Width="150"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TrackTitle" Text="Everything You Are" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold" LineHeight="15"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackArtist" Text="Hindia" Foreground="#9A9A9E"
                                   FontSize="10" LineHeight="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Sisi kanan saat collapsed: tombol pause -->
                    <Button x:Name="CollapsedPauseButton" Grid.Column="2"
                            Style="{StaticResource IconButton}" Padding="8,6"
                            VerticalAlignment="Center">
                        <Viewbox Width="10" Height="13" Stretch="Uniform">
                            <Path x:Name="CollapsedPausePath" Fill="White"
                                  Data="M0,0 h4 v13 h-4 z M6,0 h4 v13 h-4 z"/>
                        </Viewbox>
                    </Button>

                    <!-- Sisi kanan saat expanded: ikon aplikasi sumber -->
                    <Border x:Name="SourceAppIcon" Grid.Column="2" Width="20" Height="20"
                            CornerRadius="10" Background="#1DB954" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="SourceAppGlyph" Text="&#x266A;" FontSize="11"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Baris 2: progress (hanya expanded) -->
                <Grid x:Name="ProgressRow" Grid.Row="1" Visibility="Collapsed" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Text="0:11" Foreground="#9A9A9E"
                               FontSize="9.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource SlimSlider}"
                            Minimum="0" Maximum="213" Value="11" Height="12"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="-3:22"
                               Foreground="#9A9A9E" FontSize="9.5"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Baris 3: tombol kontrol (hanya expanded) -->
                <StackPanel x:Name="ControlsRow" Grid.Row="2" Visibility="Collapsed"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Padding="8">
                        <Viewbox Width="20" Height="14" Stretch="Uniform">
                            <Path Fill="White" Data="M0,0 h3 v14 h-3 z M5,7 L12,0 L12,14 z M13,7 L20,0 L20,14 z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Padding="8">
                        <Viewbox Width="12" Height="14" Stretch="Uniform">
                            <Path x:Name="PlayPausePath" Fill="White"
                                  Data="M0,0 h4 v14 h-4 z M8,0 h4 v14 h-4 z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Padding="8">
                        <Viewbox Width="20" Height="14" Stretch="Uniform">
                            <Path Fill="White" Data="M17,0 h3 v14 h-3 z M8,0 L15,7 L8,14 z M0,0 L7,7 L0,14 z"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
