<Window x:Class="WindowsNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch" Height="40" Width="250"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Obsidian Glass: hitam tetap dominan, dengan tepi dan glow tipis -->
        <LinearGradientBrush x:Key="NotchBaseBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF070708" Offset="0"/>
            <GradientStop Color="#FF08080B" Offset="0.45"/>
            <GradientStop Color="#F20B0914" Offset="0.75"/>
            <GradientStop Color="#E6110E22" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NotchSheenBrush" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#06FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="NotchHairlineBrush" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="NotchOuterBorderBrush" Color="#66000000"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#D9FFFFFF"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F7FA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8BF"/>
        <SolidColorBrush x:Key="TextSoftBrush" Color="#D0D0D6"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#85858D"/>

        <!-- Font kalender: variable display untuk judul, variable text untuk jam -->
        <FontFamily x:Key="CalendarDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="CalendarTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- Progress media: gradasi biru muda ke biru tua, tanpa ungu -->
        <LinearGradientBrush x:Key="MediaProgressBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EAF7FF" Offset="0"/>
            <GradientStop Color="#8FD3FF" Offset="0.35"/>
            <GradientStop Color="#4A90FF" Offset="0.7"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
        </LinearGradientBrush>

        <!-- Logo platform media, digambar sebagai vektor agar tetap tajam -->
        <DrawingImage x:Key="SpotifyLogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1DB954">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0B0B0B" Thickness="2.1"
                                 StartLineCap="Round" EndLineCap="Round"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <PathGeometry Figures="M5.2,8.2 C9.1,6.7 15,7.0 18.8,9.0"/>
                                <PathGeometry Figures="M5.8,11.8 C9.2,10.6 14.2,10.8 17.4,12.4"/>
                                <PathGeometry Figures="M6.4,15.2 C9.4,14.3 13.2,14.5 15.9,15.8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="ChromeLogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#EA4335">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M12,12 L2.474,6.5 A11,11 0 0 1 21.526,6.5 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#34A853">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M12,12 L12,23 A11,11 0 0 1 2.474,6.5 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FBBC05">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M12,12 L21.526,6.5 A11,11 0 0 1 12,23 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="1.2"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="12,12" EndPoint="2.474,6.5"/>
                                <LineGeometry StartPoint="12,12" EndPoint="21.526,6.5"/>
                                <LineGeometry StartPoint="12,12" EndPoint="12,23"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="5.4" RadiusY="5.4"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#4285F4">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="4.4" RadiusY="4.4"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="YouTubeLogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF0000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="1,4.5,22,15" RadiusX="4" RadiusY="4"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M10,8.2 L16.4,12 L10,15.8 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Tombol ikon tanpa chrome, dengan efek hover -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar tipis ala mockup -->
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#3A3A3A"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{StaticResource MediaProgressBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kapsul putih berisi ikon di sisi kanan notch -->
        <Style x:Key="FeatureIconButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="15" SnapsToDevicePixels="True">
                            <Image x:Name="IconImage" Source="pack://application:,,,/assets/icon.png"
                                   Width="18" Height="18" Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="IconRotate"/>
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol di dalam panel fitur -->
        <Style x:Key="PanelActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bar tipis untuk metrik sistem (CPU/RAM/disk) -->
        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#3D7EFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                    CornerRadius="1.5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="1.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Teks kalender idle -->
        <Style x:Key="CalendarWeekdayText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="CalendarDayText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Pill: ukurannya dianimasikan di dalam window yang sudah snap ukuran -->
        <Grid x:Name="PillHost" Width="250" Height="40" ClipToBounds="True"
              HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"
              AllowDrop="True">
            <!-- Shape pill: tepi atas flare keluar, bawah radius normal -->
            <Path x:Name="NotchShape" Fill="{StaticResource NotchBaseBrush}"/>
            <Path x:Name="NotchAccent" Data="{Binding Data, ElementName=NotchShape}"
                  Fill="Transparent" IsHitTestVisible="False"/>
            <Path x:Name="NotchSheen" Data="{Binding Data, ElementName=NotchShape}"
                  Fill="{StaticResource NotchSheenBrush}" IsHitTestVisible="False"/>
            <Path x:Name="NotchOuterBorder" Data="{Binding Data, ElementName=NotchShape}"
                  Fill="Transparent" Stroke="{StaticResource NotchOuterBorderBrush}"
                  StrokeThickness="2" IsHitTestVisible="False"/>
            <Path x:Name="NotchBorder" Data="{Binding Data, ElementName=NotchShape}"
                  Fill="Transparent" Stroke="{StaticResource NotchHairlineBrush}"
                  StrokeThickness="1.2" IsHitTestVisible="False"/>

        <Grid x:Name="ContentRoot" Margin="16,0">
            <!-- State 1: Idle dashboard (saat tidak ada sesi media) -->
            <Grid x:Name="IdleRoot" Visibility="Collapsed" VerticalAlignment="Stretch">
                <!-- Collapsed: hanya jam dan tanggal agar capsule tetap bersih -->
                <StackPanel x:Name="IdleCompactRoot" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="CompactClockText" Text="08:42"
                               FontSize="16" FontWeight="Bold" LineHeight="18"
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#C8C8D0" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <!-- Tidak ada garis pemisah - langsung date di bawah -->
                    <TextBlock x:Name="CompactDateText" Text="Sen, 19 Okt"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="8.5" LineHeight="10" HorizontalAlignment="Center"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Expanded: kalender mingguan dengan hari ini di tengah -->
                <Grid x:Name="IdleExpandedRoot" Visibility="Collapsed" Margin="8,8,8,0">
                    <Border Padding="9,3" Background="Transparent">
                        <Grid x:Name="IdlePageViewport" ClipToBounds="True">
                            <!-- Halaman 1: kalender -->
                            <Grid x:Name="CalendarPage">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="CalendarPageTransform"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock x:Name="CalendarMonthText" Text="November 2026"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="{StaticResource CalendarDisplayFont}"
                                               FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CalendarClockText" Text="08:42"
                                               Foreground="{StaticResource TextSoftBrush}"
                                               FontFamily="{StaticResource CalendarTextFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <UniformGrid Grid.Row="1" Columns="7" Margin="0,9,0,0">
                                    <TextBlock x:Name="CalendarWeekday0" Style="{StaticResource CalendarWeekdayText}"/>
                                    <TextBlock x:Name="CalendarWeekday1" Style="{StaticResource CalendarWeekdayText}"/>
                                    <TextBlock x:Name="CalendarWeekday2" Style="{StaticResource CalendarWeekdayText}"/>
                                    <TextBlock x:Name="CalendarWeekday3" Style="{StaticResource CalendarWeekdayText}"/>
                                    <TextBlock x:Name="CalendarWeekday4" Style="{StaticResource CalendarWeekdayText}"/>
                                    <TextBlock x:Name="CalendarWeekday5" Style="{StaticResource CalendarWeekdayText}"/>
                                    <TextBlock x:Name="CalendarWeekday6" Style="{StaticResource CalendarWeekdayText}"/>
                                </UniformGrid>

                                <UniformGrid Grid.Row="2" Columns="7" Margin="0,3,0,0">
                                    <Border x:Name="CalendarDayCircle0" Width="26" Height="26"
                                            CornerRadius="13" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalendarDayText0" Style="{StaticResource CalendarDayText}"/>
                                    </Border>
                                    <Border x:Name="CalendarDayCircle1" Width="26" Height="26"
                                            CornerRadius="13" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalendarDayText1" Style="{StaticResource CalendarDayText}"/>
                                    </Border>
                                    <Border x:Name="CalendarDayCircle2" Width="26" Height="26"
                                            CornerRadius="13" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalendarDayText2" Style="{StaticResource CalendarDayText}"/>
                                    </Border>
                                    <Border x:Name="CalendarDayCircle3" Width="28" Height="28"
                                            CornerRadius="14" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalendarDayText3" Style="{StaticResource CalendarDayText}"/>
                                    </Border>
                                    <Border x:Name="CalendarDayCircle4" Width="26" Height="26"
                                            CornerRadius="13" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalendarDayText4" Style="{StaticResource CalendarDayText}"/>
                                    </Border>
                                    <Border x:Name="CalendarDayCircle5" Width="26" Height="26"
                                            CornerRadius="13" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalendarDayText5" Style="{StaticResource CalendarDayText}"/>
                                    </Border>
                                    <Border x:Name="CalendarDayCircle6" Width="26" Height="26"
                                            CornerRadius="13" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalendarDayText6" Style="{StaticResource CalendarDayText}"/>
                                    </Border>
                                </UniformGrid>
                            </Grid>

                            <!-- Halaman 2: media player terakhir -->
                            <Grid x:Name="MediaPage" Opacity="0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="MediaPageTransform"/>
                                </Grid.RenderTransform>

                                <Grid x:Name="LastMediaContent" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="LastMediaArtBorder" Width="32" Height="32"
                                                CornerRadius="8" Background="#2B2B2B"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock x:Name="LastMediaArtPlaceholder" Text="&#x266A;"
                                                           FontSize="15"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Image x:Name="LastMediaArt" Stretch="UniformToFill"
                                                       Visibility="Collapsed">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,32,32"
                                                                           RadiusX="8" RadiusY="8"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="LastMediaTitle"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       LineHeight="15"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="LastMediaArtist"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="9.5" LineHeight="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border x:Name="LastMediaSourceIcon" Grid.Column="2"
                                                Width="18" Height="18" CornerRadius="9"
                                                Background="#1DB954"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image x:Name="LastMediaSourceLogo" Width="18" Height="18"
                                                       Stretch="Uniform" Visibility="Collapsed"/>
                                                <TextBlock x:Name="LastMediaSourceGlyph" Text="&#x266A;"
                                                           FontSize="10" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid x:Name="LastMediaProgressRow" Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LastMediaPositionText" Text="0:00"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="8.5" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Slider x:Name="LastMediaProgressSlider" Grid.Column="1"
                                                Style="{StaticResource SlimSlider}"
                                                Minimum="0" Maximum="1" Value="0" Height="10"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LastMediaDurationText" Grid.Column="2" Text="--:--"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="8.5" VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <StackPanel x:Name="LastMediaControlsRow" Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0">
                                        <Button x:Name="LastMediaPrevButton"
                                                Style="{StaticResource IconButton}" Padding="6,3">
                                            <Viewbox Width="18" Height="12" Stretch="Uniform">
                                                <Path Fill="White"
                                                      Data="M0,0 h3 v14 h-3 z M5,7 L12,0 L12,14 z M13,7 L20,0 L20,14 z"/>
                                            </Viewbox>
                                        </Button>
                                        <Button x:Name="LastMediaPlayPauseButton"
                                                Style="{StaticResource IconButton}" Padding="7,3">
                                            <Viewbox Width="11" Height="13" Stretch="Uniform">
                                                <Path x:Name="LastMediaPlayPausePath" Fill="White"
                                                      Data="M0,0 L12,7 L0,14 z"/>
                                            </Viewbox>
                                        </Button>
                                        <Button x:Name="LastMediaNextButton"
                                                Style="{StaticResource IconButton}" Padding="6,3">
                                            <Viewbox Width="18" Height="12" Stretch="Uniform">
                                                <Path Fill="White"
                                                      Data="M17,0 h3 v14 h-3 z M8,0 L15,7 L8,14 z M0,0 L7,7 L0,14 z"/>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="LastMediaEmptyPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#x266A;" FontSize="20"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource NoRecentMedia}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="9.5" Margin="0,4,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Halaman 3: metrik sistem -->
                            <Grid x:Name="MetricsPage" Opacity="0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="MetricsPageTransform"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock Text="{DynamicResource Metrics}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="9.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <StackPanel x:Name="ExpandedBatteryPanel"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Border Width="20" Height="10" BorderBrush="#C8C8CC"
                                                BorderThickness="1" CornerRadius="2"
                                                VerticalAlignment="Center">
                                            <Grid Margin="1">
                                                <Border x:Name="ExpandedBatteryFill" Width="0"
                                                        HorizontalAlignment="Left" Background="#4CD964"
                                                        CornerRadius="1"/>
                                            </Grid>
                                        </Border>
                                        <Border Width="2" Height="4" Background="#C8C8CC" CornerRadius="1"
                                                Margin="1,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ExpandedBatteryText" Text="82%"
                                                   Foreground="{StaticResource TextSoftBrush}"
                                                   FontSize="8.5" Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ExpandedCpuRow" Grid.Row="1"
                                      Height="16" Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="9.5" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="ExpandedCpuBar" Grid.Column="1"
                                                 Style="{StaticResource MetricBar}"
                                                 Height="4" Margin="6,0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedCpuText" Grid.Column="2" Text="--%"
                                               Foreground="{StaticResource TextSoftBrush}"
                                               FontSize="9.5" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid x:Name="ExpandedRamRow" Grid.Row="2"
                                      Height="16" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="9.5" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="ExpandedRamBar" Grid.Column="1"
                                                 Style="{StaticResource MetricBar}"
                                                 Height="4" Margin="6,0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedRamText" Grid.Column="2" Text="--%"
                                               Foreground="{StaticResource TextSoftBrush}"
                                               FontSize="9.5" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid x:Name="ExpandedDiskRow" Grid.Row="3"
                                      Height="16" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ExpandedDiskLabel" Text="C:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="9.5" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="ExpandedDiskBar" Grid.Column="1"
                                                 Style="{StaticResource MetricBar}"
                                                 Height="4" Margin="6,0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExpandedDiskText" Grid.Column="2" Text="--%"
                                               Foreground="{StaticResource TextSoftBrush}"
                                               FontSize="9.5" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- State 3: Mode sisi (menempel layar kiri/kanan), collapsed -->
            <StackPanel x:Name="SideCollapsedRoot" Width="40" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="SideAlbumArtBorder" Width="24" Height="24"
                        CornerRadius="6" Background="#2B2B2B">
                    <Grid>
                        <TextBlock x:Name="SideAlbumArtPlaceholder" Text="&#x266A;" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="SideAlbumArt" Stretch="UniformToFill" Visibility="Collapsed">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <Button x:Name="SidePauseButton" Style="{StaticResource IconButton}"
                        Padding="8,6" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Viewbox Width="10" Height="13" Stretch="Uniform">
                        <Path x:Name="SidePausePath" Fill="White"
                              Data="M0,0 h4 v13 h-4 z M6,0 h4 v13 h-4 z"/>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- Idle mode sisi: hanya jam, hari, dan tanggal -->
            <StackPanel x:Name="SideIdleRoot" Width="40" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="SideHourText" Text="08" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           LineHeight="13"/>
                <TextBlock x:Name="SideMinuteText" Text="42" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           LineHeight="13" Margin="0,-1,0,0"/>
                <Border x:Name="SideDivider" Width="16" Height="0.75"
                        Background="{StaticResource DividerBrush}" CornerRadius="0.5"
                        Margin="0,6,0,0"/>
                <TextBlock x:Name="SideDayText" Text="Sen" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="SideDateText" Text="19 Okt" Foreground="{StaticResource TextSoftBrush}"
                           FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- State 2: Media player (sesuai mockup) -->
            <Grid x:Name="MediaRoot" VerticalAlignment="Top" Margin="0,6.5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Baris 1: album art + judul/artist + sisi kanan -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="AlbumArtBorder" Width="24" Height="24"
                            CornerRadius="6" Background="#2B2B2B" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="AlbumArtPlaceholder" Text="&#x266A;" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image x:Name="AlbumArt" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="TextStack" Grid.Column="1" Width="150"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TrackTitle" Text="Everything You Are" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold" LineHeight="15"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackArtist" Text="Hindia" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" LineHeight="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Sisi kanan saat collapsed: tombol pause -->
                    <Button x:Name="CollapsedPauseButton" Grid.Column="2"
                            Style="{StaticResource IconButton}" Padding="8,6"
                            VerticalAlignment="Center">
                        <Viewbox Width="10" Height="13" Stretch="Uniform">
                            <Path x:Name="CollapsedPausePath" Fill="White"
                                  Data="M0,0 h4 v13 h-4 z M6,0 h4 v13 h-4 z"/>
                        </Viewbox>
                    </Button>

                    <!-- Sisi kanan saat expanded: ikon aplikasi sumber -->
                    <Border x:Name="SourceAppIcon" Grid.Column="2" Width="20" Height="20"
                            CornerRadius="10" Background="#1DB954" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="SourceAppLogo" Width="20" Height="20"
                                   Stretch="Uniform" Visibility="Collapsed"/>
                            <TextBlock x:Name="SourceAppGlyph" Text="&#x266A;" FontSize="11"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Baris 2: progress (hanya expanded) -->
                <Grid x:Name="ProgressRow" Grid.Row="1" Visibility="Collapsed" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Text="0:11" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource SlimSlider}"
                            Minimum="0" Maximum="213" Value="11" Height="12"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="-3:22"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="9.5"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Baris 3: tombol kontrol (hanya expanded) -->
                <StackPanel x:Name="ControlsRow" Grid.Row="2" Visibility="Collapsed"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Padding="8">
                        <Viewbox Width="20" Height="14" Stretch="Uniform">
                            <Path Fill="White" Data="M0,0 h3 v14 h-3 z M5,7 L12,0 L12,14 z M13,7 L20,0 L20,14 z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Padding="8">
                        <Viewbox Width="12" Height="14" Stretch="Uniform">
                            <Path x:Name="PlayPausePath" Fill="White"
                                  Data="M0,0 h4 v14 h-4 z M8,0 h4 v14 h-4 z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Padding="8">
                        <Viewbox Width="20" Height="14" Stretch="Uniform">
                            <Path Fill="White" Data="M17,0 h3 v14 h-3 z M8,0 L15,7 L8,14 z M0,0 L7,7 L0,14 z"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="DropIndicator" Margin="4"
                Background="#E61C1C1E" BorderBrush="#3D7EFF"
                BorderThickness="1.5" CornerRadius="18"
                IsHitTestVisible="False" Panel.ZIndex="5"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="DropConvertZone" Background="Transparent"
                        CornerRadius="17,0,0,17">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Viewbox x:Name="DropConvertIcon" Width="12" Height="12"
                                 Margin="0,0,6,0">
                            <Path Data="M2,1.5 H8.5 L11,4 V12.5 H2 Z M8.5,1.5 V4 H11 M4,6.5 H8 M4.8,9.5 H9.4 M7.2,7.3 L9.4,9.5 L7.2,11.7"
                                  Stroke="#F5F5F7" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock x:Name="DropConvertLabel"
                                   Text="{DynamicResource DropToConvertDownloads}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="9.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="DropPathZone" Grid.Column="1"
                        Background="Transparent" CornerRadius="0,17,17,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Viewbox x:Name="DropPathIcon" Width="12" Height="12"
                                 Margin="0,0,6,0">
                            <Path Data="M1.5,4 H6 L7.2,5.2 H11.5 V10.5 H1.5 Z"
                                  Stroke="#F5F5F7" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock x:Name="DropPathLabel"
                                   Text="{DynamicResource DropToPath}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="9.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.ColumnSpan="2" Width="1" Margin="0,9"
                        HorizontalAlignment="Center" Background="#3A3A3E"
                        Opacity="0.8"/>
            </Grid>
        </Border>
        </Grid>

        <!-- Kapsul putih berisi icon.png, menempel di sisi kanan notch -->
        <Button x:Name="FeatureButton" Width="30" Height="30"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="0,5,0,0" Panel.ZIndex="10"
                Style="{StaticResource FeatureIconButton}"/>

        <!-- Panel fitur yang meluncur ke kanan -->
        <Popup x:Name="FeaturePopup"
               PlacementTarget="{Binding ElementName=FeatureButton}"
               Placement="Right"
               HorizontalOffset="8"
               VerticalOffset="-1"
               AllowsTransparency="True"
               PopupAnimation="None"
               StaysOpen="True"
               Focusable="False">
            <Border x:Name="FeaturePanelCard" Background="#1C1C1E"
                    BorderBrush="#2E2E30" BorderThickness="1"
                    CornerRadius="10" Padding="3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                      Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Button x:Name="FileButton" MinWidth="96" Padding="12,6"
                            IsEnabled="False"
                            Style="{StaticResource PanelActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="13" Height="13"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="M1.5,3 H6 L7.5,4.5 H12.5 V11.5 H1.5 Z"
                                      Stroke="#F5F5F7" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock x:Name="FileMenuLabel" Grid.Column="1" Text="{DynamicResource FileTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5"
                                       FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NoteButton" MinWidth="96" Padding="12,6"
                            Margin="0,2,0,0"
                            Style="{StaticResource PanelActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="13" Height="13"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="M2,1.5 H8.5 L11,4 V12.5 H2 Z M8.5,1.5 V4 H11 M4,6.5 H9 M4,9 H9"
                                      Stroke="#F5F5F7" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Notes}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsButton" MinWidth="96" Padding="12,6"
                            Margin="0,2,0,0"
                            Style="{StaticResource PanelActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="13" Height="13"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="M1,3 H13 M1,7 H13 M1,11 H13 M4,1.5 V4.5 M9,5.5 V8.5 M5,9.5 V12.5"
                                      Stroke="#F5F5F7" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Settings}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ExitButton" MinWidth="96" Padding="12,6"
                            Margin="0,2,0,0"
                            Style="{StaticResource PanelActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="13" Height="13"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Data="M6,1 L6,6 M2.8,2.8 A5,5 0 1 0 9.2,2.8"
                                      Stroke="#F5F5F7" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Exit}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="StatusPopup"
               PlacementTarget="{Binding ElementName=PillHost}"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="8"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               Focusable="False">
            <Border x:Name="StatusPopupCard" Background="#E61C1C1E"
                    BorderBrush="#3D7EFF" BorderThickness="1"
                    CornerRadius="8" Padding="10,6"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                      Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <TextBlock x:Name="StatusPopupText" Foreground="#F5F5F7"
                           FontSize="10" FontWeight="SemiBold"
                           MaxWidth="320" TextWrapping="Wrap"/>
            </Border>
        </Popup>
    </Grid>
</Window>
