<Window x:Class="WindowsNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="280" Height="390"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SettingsCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLanguageOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D0D0D6"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#2C2C2E" CornerRadius="6"
                                Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D7EFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="30" Height="17"
                                CornerRadius="8.5" Background="#3A3A3E">
                            <Border x:Name="Thumb" Width="13" Height="13"
                                    CornerRadius="6.5" Background="#FFFFFF"
                                    HorizontalAlignment="Left" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4A4A4E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3D7EFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1C1C1E" BorderBrush="#2E2E30" BorderThickness="1"
            CornerRadius="12" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                              Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                        <Path Data="M1,3 H13 M1,7 H13 M1,11 H13 M4,1.5 V4.5 M9,5.5 V8.5 M5,9.5 V12.5"
                              Stroke="#F5F5F7" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource SettingsTitle}" Foreground="#F5F5F7"
                               FontSize="11.5" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Text="{DynamicResource Saved}"
                           Foreground="#6E6E73" FontSize="9"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,22,0"/>

                <Button x:Name="CloseButton" Width="18" Height="18"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SettingsCloseButton}"
                        Content="&#x2715;" FontSize="9"
                        Foreground="#9A9A9E"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource Metrics}" Foreground="#6E6E73"
                           FontSize="8" FontWeight="Bold"/>

                <Grid Height="24" Margin="0,4,0,0">
                    <TextBlock Text="CPU" Foreground="#F5F5F7" FontSize="11"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowCpuToggle"
                              Style="{StaticResource SettingsToggle}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Height="24" Margin="0,2,0,0">
                    <TextBlock Text="RAM" Foreground="#F5F5F7" FontSize="11"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowRamToggle"
                              Style="{StaticResource SettingsToggle}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Height="24" Margin="0,2,0,0">
                    <TextBlock Text="Disk" Foreground="#F5F5F7" FontSize="11"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowDiskToggle"
                              Style="{StaticResource SettingsToggle}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Height="24" Margin="0,2,0,0">
                    <TextBlock Text="{DynamicResource Battery}" Foreground="#F5F5F7" FontSize="11"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowBatteryToggle"
                              Style="{StaticResource SettingsToggle}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#2E2E30" Margin="0,10,0,0"/>

                <TextBlock Text="{DynamicResource System}" Foreground="#6E6E73"
                           FontSize="8" FontWeight="Bold" Margin="0,10,0,0"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource StartupTitle}"
                                   Foreground="#F5F5F7" FontSize="11"/>
                        <TextBlock Text="{DynamicResource StartupDescription}"
                                   Foreground="#6E6E73" FontSize="8.5"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                              Style="{StaticResource SettingsToggle}"
                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <Border Height="1" Background="#2E2E30" Margin="0,10,0,0"/>

                <TextBlock Text="{DynamicResource LanguageSection}" Foreground="#6E6E73"
                           FontSize="8" FontWeight="Bold" Margin="0,10,0,0"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="IndonesianOption" Grid.Column="0"
                                 GroupName="Language"
                                 Content="{DynamicResource LanguageIndonesian}"
                                 Style="{StaticResource SettingsLanguageOption}"/>
                    <RadioButton x:Name="EnglishOption" Grid.Column="1"
                                 GroupName="Language"
                                 Content="{DynamicResource LanguageEnglish}"
                                 Style="{StaticResource SettingsLanguageOption}"
                                 Margin="4,0,0,0"/>
                </Grid>

                <Border Height="1" Background="#2E2E30" Margin="0,10,0,0"/>

                <TextBlock Text="{DynamicResource HotkeySection}" Foreground="#6E6E73"
                           FontSize="8" FontWeight="Bold" Margin="0,10,0,0"/>

                <Grid Margin="0,5,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource HotkeyTitle}"
                                   Foreground="#F5F5F7" FontSize="11"/>
                        <TextBlock Text="{DynamicResource HotkeyDescription}"
                                   Foreground="#6E6E73" FontSize="8.5"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border x:Name="HotkeyRecorder"
                            Background="#2C2C2E" CornerRadius="6"
                            Padding="10,5" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Cursor="Hand"
                            MinWidth="90" BorderThickness="1"
                            BorderBrush="#3A3A3E">
                        <TextBlock x:Name="HotkeyLabel"
                                   Foreground="#F5F5F7" FontSize="10"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
