<Window x:Class="WindowsNotch.ConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ConvertTitle}" Width="380" Height="500"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="ConvertCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConvertIconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConvertTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConvertOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#242426"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#3A3A3E" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConvertCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Background="#141416"
                                BorderBrush="#3A3A3E" BorderThickness="1"
                                CornerRadius="3">
                            <Path x:Name="Check"
                                  Data="M2.5,6.5 L5.2,9 L10,3.5"
                                  Stroke="#F5F5F7" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="#6E6E73"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="#3D7EFF"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="#3D7EFF"/>
                                <Setter TargetName="Check" Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConvertPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3D7EFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A93FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D6BE0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#1C1C1E" BorderBrush="#2E2E30"
            BorderThickness="1" CornerRadius="12" Padding="12"
            AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                              Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                        <Path Data="M2,1.5 H8.5 L11,4 V12.5 H2 Z M8.5,1.5 V4 H11 M4,6.5 H8 M4,9 H7"
                              Stroke="#F5F5F7" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource ConvertTitle}" Foreground="#F5F5F7"
                               FontSize="11.5" FontWeight="SemiBold"/>
                </StackPanel>

                <Button x:Name="CloseButton" Width="18" Height="18"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ConvertCloseButton}"
                        Content="&#x2715;" FontSize="9"
                        Foreground="#9A9A9E"/>
            </Grid>

            <Border x:Name="DropZone" Grid.Row="1" Background="#141416"
                    BorderBrush="#2E2E30" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,9,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ConvertDropHint}" Foreground="#B8B8BF"
                               FontSize="9.5" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="ChooseFilesButton"
                            Content="{DynamicResource ConvertChooseFiles}"
                            Style="{StaticResource ConvertOutlineButton}"
                            HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource ConvertLegacyDocNote}" Foreground="#6E6E73"
                               FontSize="8" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,9,0,0" MinHeight="90">
                <ScrollViewer x:Name="QueueScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="QueueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141416" BorderBrush="#2E2E30"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="7,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource ConvertCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelectable}"
                                                  ToolTip="{DynamicResource ConvertSelectFile}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"/>

                                        <Viewbox Grid.Column="1" Width="13" Height="13"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center">
                                            <Path Data="M2,1.5 H8.5 L11,4 V12.5 H2 Z M8.5,1.5 V4 H11"
                                                  Stroke="#9A9A9E" StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                        </Viewbox>

                                        <StackPanel Grid.Column="2" Margin="7,0,6,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       ToolTip="{Binding Location}"
                                                       Foreground="#F5F5F7"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,1,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ConversionLabel}"
                                                           Foreground="#6E6E73"
                                                           FontSize="8.5"/>
                                                <TextBlock Grid.Column="1" Text="  &#x2022;  "
                                                           Foreground="#3A3A3E"
                                                           FontSize="8.5"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding StatusText}"
                                                           Foreground="{Binding StatusBrush}"
                                                           ToolTip="{Binding WarningToolTip}"
                                                           FontSize="8.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}"
                                                       ToolTip="{Binding Detail}"
                                                       Foreground="#6E6E73"
                                                       FontSize="8.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Click="OnOpenOutputClick"
                                                    ToolTip="{DynamicResource Open}"
                                                    IsEnabled="{Binding CanOpenOutput}"
                                                    Style="{StaticResource ConvertIconButton}">
                                                <Viewbox Width="11" Height="11">
                                                    <Path Data="M3,10 L10,3 M5,3 H10 V8"
                                                          Stroke="#F5F5F7"
                                                          StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnShowOutputClick"
                                                    ToolTip="{DynamicResource RevealInExplorer}"
                                                    IsEnabled="{Binding CanOpenOutput}"
                                                    Style="{StaticResource ConvertIconButton}">
                                                <Viewbox Width="11" Height="11">
                                                    <Path Data="M1.5,4 H6 L7.2,5.2 H11.5 V10.5 H1.5 Z"
                                                          Stroke="#F5F5F7"
                                                          StrokeThickness="1.3"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnRemoveItemClick"
                                                    ToolTip="{DynamicResource RemoveItem}"
                                                    IsEnabled="{Binding IsRemovable}"
                                                    Style="{StaticResource ConvertIconButton}"
                                                    Margin="2,0,0,0">
                                                <Viewbox Width="10" Height="10">
                                                    <Path Data="M1,1 L9,9 M9,1 L1,9"
                                                          Stroke="#9A9A9E"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyState" Text="{DynamicResource ConvertEmpty}"
                           Foreground="#6E6E73" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="3" Text=""
                       Foreground="#6E6E73" FontSize="8.5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,7,0,0"/>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="QueueCountText" Text="{DynamicResource FileCountOne}"
                           Foreground="#6E6E73" FontSize="8.5"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="ClearButton" Content="{DynamicResource Clear}"
                            Style="{StaticResource ConvertTextButton}"/>
                    <Button x:Name="CancelButton" Content="{DynamicResource ConvertCancel}"
                            Style="{StaticResource ConvertTextButton}"
                            Margin="4,0,0,0" IsEnabled="False"/>
                    <Button x:Name="ConvertSelectedButton"
                            Content="{DynamicResource ConvertSelected}"
                            Style="{StaticResource ConvertPrimaryButton}"
                            Padding="10,5" Margin="6,0,0,0"/>
                    <Button x:Name="ConvertAllButton" Content="{DynamicResource ConvertAll}"
                            Style="{StaticResource ConvertOutlineButton}"
                            Padding="10,5" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
